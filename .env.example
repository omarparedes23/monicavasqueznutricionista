# ============================================================
# VARIABLES DE ENTORNO — monicanutri
# Copia este archivo a .env.local y completá los valores.
# NUNCA commitees .env.local.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sitio (base URL pública, usada en links de invitación)
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 (planes, fotos y catálogo de tienda)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=

# Emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Integraciones externas (bot de Rust): API key dedicada.
# NO usar la service role key como Bearer token.
INTEGRATION_API_KEY=
