# ============================================================
# VARIABLES DE ENTORNO - Copia este archivo a .env.local
# y completa con tus valores reales. NUNCA subas .env.local a git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Obtén estas desde tu proyecto en https://supabase.com
# Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (solo backend, NUNCA exponer al cliente)
# Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (emails) ──────────────────────────────────────────
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email "from" verificado en Resend (debe ser de tu dominio)
# Ejemplo: "Monica García <citas@tudominio.com>"
RESEND_FROM_EMAIL=citas@tudominio.com
